+// jump to the nearest DO_LAND_START in the mission and run the mission from there in Auto
+// returns false if there is no DO_LAND_START in the mission or the switch to Auto fails
+bool ModeAuto::jump_to_landing_sequence(ModeReason reason)
+{
+    // already running the DO_LAND_START sequence in Auto, so keep going
+    if ((rover.control_mode == this) &&
+        (mission.state() == AP_Mission::MISSION_RUNNING) &&
+        mission.get_in_landing_sequence_flag()) {
+        return true;
+    }
+
+    Location loc;
+    if (!ahrs.get_location(loc)) {
+        return false;
+    }
+
+    if (!mission.jump_to_landing_sequence(loc)) {
+        return false;
+    }
+
+    // entering Auto (or Auto still waiting to start) calls start_or_resume(), which
+    // must resume at the DO_LAND_START rather than restart if MIS_RESTART is set
+    const bool will_start_mission = (rover.control_mode != this) || waiting_to_start;
+    if (will_start_mission) {
+        mission.set_force_resume(true);
+    }
+
+    if (rover.set_mode(*this, reason)) {
+        return true;
+    }
+
+    // mode change failed, revert force resume flag
+    if (will_start_mission) {
+        mission.set_force_resume(false);
+    }
+    return false;
+}
